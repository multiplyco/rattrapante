{:paths         ["src" "resources" "target/classes" ]
 :deps          {org.clojure/clojure {:mvn/version "1.12.6"}}
 :deps/prep-lib {:alias :build :fn compile-java :ensure "target/classes/co/multiply/rattrapante/internal/Bindings.class"}
 :aliases
 {:dev   {:extra-paths ["dev"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}
  :test  {:extra-paths ["test"]
          :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Drattrapante.track-native=true"]
          :main-opts   ["-m" "kaocha.runner"]}
  :build {:ns-default build
          :deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy           {:mvn/version "0.2.5"}}}}}
